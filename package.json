{
  "name": "relay-private-phone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "node server/start.mjs --dev",
    "build": "vite build",
    "start": "node server/start.mjs",
    "account": "node server/account.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/integration-browser.mjs",
    "test:integration": "node tests/integration-browser.mjs",
    "icons": "node scripts/icons.mjs",
    "bundle": "node scripts/bundle.mjs",
    "format": "prettier --write src server scripts tests docs README.md AGENTS.md package.json vite.config.js index.html public/manifest.webmanifest",
    "format:check": "prettier --check src server scripts tests docs README.md AGENTS.md package.json vite.config.js index.html public/manifest.webmanifest"
  },
  "dependencies": {
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "web-push": "3.6.7",
    "ws": "8.21.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.0",
    "@fontsource/vazirmatn": "^5.2.0",
    "@playwright/test": "^1.58.0",
    "@vitejs/plugin-react": "^5.0.0",
    "archiver": "^7.0.1",
    "prettier": "^3.9.8",
    "sharp": "^0.35.4",
    "vite": "^7.0.0"
  },
  "license": "MIT",
  "description": "Self-hosted SMS, contacts, and cellular calls from a browser, built for a rooted Xperia.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cheeseburger08/relay.git"
  }
}
