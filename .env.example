# Local development. The URL must match your browser's exact origin.
HOST=127.0.0.1
PORT=49760
PUBLIC_ORIGIN=http://127.0.0.1:49760
# DATA_DIR=/absolute/private/relay-data

# Production: use a dedicated HTTPS host and private data directory.
# REQUIRE_HTTPS=1
# PUBLIC_ORIGIN=https://relay.example.com
# BEHIND_PROXY=1
# Or configure direct TLS instead of BEHIND_PROXY:
# TLS_KEY=/etc/relay/tls/private-key.pem
# TLS_CERT=/etc/relay/tls/fullchain.pem
# VAPID_PUBLIC_KEY=your-generated-public-key
# VAPID_PRIVATE_KEY=your-generated-private-key
